// 此配置使用 KDL 格式： https://kdl.dev
// 在节点前加 "/-" 可以将该节点注释掉（使其失效）。
// 详情请查看维基中的完整配置说明：
// https://yalter.github.io/niri/Configuration:-Introduction


// ================开机启动配置==============
// 注意：以会话方式运行 niri 支持 xdg-desktop-autostart，使用该方式可能更为方便。
// 更多启动示例请参阅下方的 binds 节。
// 下面这一行会启动 waybar，一个常用的 Wayland 状态栏程序。
spawn-at-startup "swaybg" "-i" "/home/linsoap/my-nix/assets/wallpaper.jpg" "-m" "fill"
spawn-at-startup "xwayland-satellite"



cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 20
}

input {
    keyboard {
        xkb {}
        numlock
    }

    // 接下来的部分包含 libinput 的设置。
    // 省略某项设置会禁用该项或使用其默认值。
    // 这里被注释掉的设置都是示例，而非默认值。
    touchpad {
    // off
    tap
    // dwt
    // dwtp
    // drag false
    // drag-lock
    natural-scroll
    // accel-speed 0.2
    // accel-profile "flat"
    // scroll-method "two-finger"
    // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 取消注释此行可使鼠标在新获得焦点的窗口中心处跳转。
    warp-mouse-to-focus

    // 将鼠标移动到窗口或输出上时，自动聚焦它们。
    // 将 max-scroll-amount="0%" 可使其仅对已完全显示在屏幕上的窗口生效。
    // focus-follows-mouse max-scroll-amount="0%"
}

// 你可以按输出名称配置显示设备（在 niri 运行时使用 `niri msg outputs` 可查看名称）。
// 小米 4K 显示器 - 左上角
output "Xiaomi Corporation Mi Monitor 7089300021199" {
    mode "3840x2160@59.997"
    scale 1.5
    transform "normal"
    position x=0 y=0
}

// HDMI-A-1 显示器 - 小米显示器右侧
output "Technical Concepts Ltd R27Q61 S0258500002" {
    mode "2560x1440@143.999"
    scale 1
    transform "normal"
    position x=2560 y=0
}

// 内置显示器 - 下方居中（在两个外接显示器下面）
output "Samsung Display Corp. ATNA40HQ01-0  Unknown" {
    mode "2880x1800@120.000"
    scale 1.75
    transform "normal"
    position x=1737 y=1440
}

// P25H2G - 左侧显示器
output "Beihai Century Joint Innovation Technology Co.,Ltd P25H2G 0000000000000" {
    mode "1920x1080@165.001"
    scale 1
    transform "normal"
    position x=0 y=0
}

// P24A2G - 右侧显示器
output "Beihai Century Joint Innovation Technology Co.,Ltd P24A2G 0000000000000" {
    mode "1920x1080@164.997"
    scale 1
    transform "normal"
    position x=1920 y=0
}

// Haier 4K TV - 内置显示器上方（直接相连）
output "Qingdao Haier Electronics Co., Ltd. HAIER TV 0x00000001" {
    mode "3840x2160@60.000"
    scale 2.0
    transform "normal"
    position x=1599 y=360
}

// 影响窗口定位与大小的设置。
// 更多信息请见维基：
// https://yalter.github.io/niri/Configuration:-Layout
layout {
    // 以逻辑像素设置窗口周围的间隙（gaps）。
    gaps 8

    center-focused-column "never"

    // 可自定义 "switch-preset-column-width"（Mod+R）在切换时使用的宽度集合。
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

    // fixed 则以逻辑像素精确设置宽度。
    // fixed 1920
    }

    // preset-window-heights { }

    // 可更改新窗口的默认宽度。
    default-column-width { }
    focus-ring {
    // 取消注释此行可禁用焦点环。
    // off

    // 焦点环从窗口向外延伸的逻辑像素数。
        width 2
        active-color "#000000"
        inactive-color "#e3e3e3"
    }

    // 你也可以添加边框。它类似于焦点环，但始终可见。
    border {
    // 这些设置与焦点环相同。
    // 如果启用边框，通常会选择禁用焦点环。
        off

        width 4
        active-color "#ffc87f"
        inactive-color "#505050"

        // 请求关注的窗口周围边框的颜色（urgent color）。
        urgent-color "#9b0000"
    }

    struts {
        left 16
        right 16
        // top 64
        // bottom 64
    }
}



hotkey-overlay {
    skip-at-startup
}


prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 动画设置。
// 维基解释了如何配置各个动画：
// https://yalter.github.io/niri/Configuration:-Animations
animations {
    // 取消注释以关闭所有动画。
    // off

    // 通过该因子降低所有动画速度；小于 1 的值会加速动画。
    // slowdown 3.0
}

// 窗口规则允许你调整单个窗口的行为。
// 更多信息请见维基：
// https://yalter.github.io/niri/Configuration:-Window-Rules

// 通过设置空的 default-column-width 来规避 WezTerm 的初始配置 bug。
window-rule {
    // 这个正则表达式故意尽可能具体，因为这是默认配置，我们不希望出现误报。
    // 如果愿意，你也可以只使用 app-id="wezterm"。
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// 示例：将两个密码管理器排除在屏幕捕获之外。
// （该示例规则在前面用 "/-" 注释掉。）
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // 如果希望在第三方截图工具中仍然可见，可使用此项替代。
    // block-out-from "screencast"
}

// 示例：为所有窗口启用圆角。
// （该示例规则在前面用 "/-" 注释掉。）
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

binds {
    // 按键由若干修饰键（modifiers）用 + 分隔，最后跟随一个 XKB 键名构成。
    // 要查找某个键对应的 XKB 名称，可以使用类似 wev 的工具。
    //
    // "Mod" 是一个特殊修饰键：在 TTY 环境下等同于 Super，作为 winit 窗口时等同于 Alt。
 

    // Mod-Shift-/（通常与 Mod-? 相同）显示重要热键列表。
    Mod+Shift+Slash { show-hotkey-overlay; }

    // 建议用于运行程序的绑定：终端、应用程序启动器、屏幕锁定器。
    Mod+E { spawn "nautilus" "--new-window"; }
    Ctrl+Alt+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Super+D hotkey-overlay-title="Run an Application: wofi" { spawn-sh "wofi -S drun"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }


    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // 打开/关闭 Overview：工作区和窗口的缩小视图。
    // 你也可以将鼠标移动到左上角热角，或在触摸板上进行四指向上滑动。
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+H     { focus-column-left; }   // 聚焦到左侧列（Vim 风格）
    Mod+J     { focus-window-down; }   // 聚焦到下方窗口（Vim 风格）
    Mod+K     { focus-window-up; }     // 聚焦到上方窗口（Vim 风格）
    Mod+L     { focus-column-right; }  // 聚焦到右侧列（Vim 风格）

    Mod+Ctrl+H     { move-column-left; }   // 移动列到左侧（Vim 风格）
    Mod+Ctrl+J     { move-window-down; }   // 移动窗口到下方（Vim 风格）
    Mod+Ctrl+K     { move-window-up; }     // 移动窗口到上方（Vim 风格）
    Mod+Ctrl+L     { move-column-right; }  // 移动列到右侧（Vim 风格）

    // 当到达列中的第一个或最后一个窗口时，跨工作区移动的替代命令。
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Shift+H     { focus-monitor-left; }   // 聚焦到左侧显示器（Vim 风格）
    Mod+Shift+J     { focus-monitor-down; }  // 聚焦到下方显示器（Vim 风格）
    Mod+Shift+K     { focus-monitor-up; }    // 聚焦到上方显示器（Vim 风格）
    Mod+Shift+L     { focus-monitor-right; } // 聚焦到右侧显示器（Vim 风格）

    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }   // 移动列到左侧显示器（Vim 风格）
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }  // 移动列到下方显示器（Vim 风格）
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }    // 移动列到上方显示器（Vim 风格）
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; } // 移动列到右侧显示器（Vim 风格）

    // 或者，有命令仅移动单个窗口：
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // 你也可以将整个工作区移动到另一个显示器：
    // Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    // ...

    Mod+U              { focus-workspace-down; }    // 聚焦到下方工作区（Vim 风格）
    Mod+I              { focus-workspace-up; }      // 聚焦到上方工作区（Vim 风格）
    Mod+Ctrl+U         { move-column-to-workspace-down; }  // 移动列到下方工作区（Vim 风格）
    Mod+Ctrl+I         { move-column-to-workspace-up; }    // 移动列到上方工作区（Vim 风格）

    // 或者，有命令仅移动单个窗口：
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+U         { move-workspace-down; }  // 移动工作区到下方（Vim 风格）
    Mod+Shift+I         { move-workspace-up; }    // 移动工作区到上方（Vim 风格）

    // 你可以使用以下语法绑定鼠标滚轮滚动刻度。
    // 这些绑定会根据 natural-scroll 设置改变方向。
    //
    // 为避免快速滚动工作区，你可以使用 cooldown-ms 属性。
    // 该绑定将被限制为此值。你可以在任何绑定上设置冷却，但对滚轮最有用。
    Mod+Shift+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }  // 滚轮向下切换工作区
    Mod+Shift+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }    // 滚轮向上切换工作区

    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }  // 滚轮向下移动列
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }    // 滚轮向上移动列

    Mod+WheelScrollRight      { focus-column-right; }  // 滚轮向右聚焦列
    Mod+WheelScrollLeft       { focus-column-left; }   // 滚轮向左聚焦列
    //Mod+Ctrl+WheelScrollRight { move-column-right; }   // 滚轮向右移动列
    //Mod+Ctrl+WheelScrollLeft  { move-column-left; }    // 滚轮向左移动列

    // 通常在应用程序中按住 Shift 向上或向下滚动会导致水平滚动；这些绑定复制了该行为。
    Mod+WheelScrollDown      { focus-column-right; }  // Shift+滚轮向下聚焦右侧列
    Mod+WheelScrollUp        { focus-column-left; }   // Shift+滚轮向上聚焦左侧列

    //Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }   // Shift+滚轮向下移动列到右侧
    //Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }    // Shift+滚轮向上移动列到左侧

    // 类似地，你可以绑定触摸板滚动"刻度"。
    // 触摸板滚动是连续的，所以这些绑定被分割成
    // 离散的间隔。
    // 这些绑定也受触摸板的 natural-scroll 设置影响，所以这些
    // 示例绑定是"反向"的，因为我们默认为触摸板启用了自然滚动。
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // 你可以通过索引引用工作区。但是，请记住
    // niri 是一个动态工作区系统，所以这些命令有点像
    // "尽力而为"。尝试引用大于当前工作区数量的工作区索引
    // 将转而引用最底部（空）的工作区。
    //
    // 例如，有 2 个工作区 + 1 个空工作区时，索引 3、4、5 等等
    // 都将引用第 3 个工作区。
    Mod+1 { focus-workspace 1; }  // 聚焦到工作区 1
    Mod+2 { focus-workspace 2; }  // 聚焦到工作区 2
    Mod+3 { focus-workspace 3; }  // 聚焦到工作区 3
    Mod+4 { focus-workspace 4; }  // 聚焦到工作区 4
    Mod+5 { focus-workspace 5; }  // 聚焦到工作区 5
    Mod+6 { focus-workspace 6; }  // 聚焦到工作区 6
    Mod+7 { focus-workspace 7; }  // 聚焦到工作区 7
    Mod+8 { focus-workspace 8; }  // 聚焦到工作区 8
    Mod+9 { focus-workspace 9; }  // 聚焦到工作区 9
    Mod+Ctrl+1 { move-column-to-workspace 1; }  // 移动列到工作区 1
    Mod+Ctrl+2 { move-column-to-workspace 2; }  // 移动列到工作区 2
    Mod+Ctrl+3 { move-column-to-workspace 3; }  // 移动列到工作区 3
    Mod+Ctrl+4 { move-column-to-workspace 4; }  // 移动列到工作区 4
    Mod+Ctrl+5 { move-column-to-workspace 5; }  // 移动列到工作区 5
    Mod+Ctrl+6 { move-column-to-workspace 6; }  // 移动列到工作区 6
    Mod+Ctrl+7 { move-column-to-workspace 7; }  // 移动列到工作区 7
    Mod+Ctrl+8 { move-column-to-workspace 8; }  // 移动列到工作区 8
    Mod+Ctrl+9 { move-column-to-workspace 9; }  // 移动列到工作区 9

    // 或者，有命令仅移动单个窗口：
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // 在当前工作区和之前的工作区之间切换焦点。
    // Mod+Tab { focus-workspace-previous; }

    // 以下绑定用于将聚焦窗口移入和移出列。
    // 如果窗口是单独的，它们会将其合并到侧边的附近列中。
    // 如果窗口已经在列中，它们会将其排出。
    // Mod+BracketLeft  { consume-or-expel-window-left; }  // 从左侧合并/排出窗口
    // Mod+BracketRight { consume-or-expel-window-right; } // 从右侧合并/排出窗口

    // 从右侧合并一个窗口到聚焦列的底部。
    // Mod+Comma  { consume-window-into-column; } // 合并窗口到列
    // 将聚焦列的底部窗口排出到右侧。
    // Mod+Period { expel-window-from-column; }   // 从列排出窗口

    Mod+R { switch-preset-column-width; }      // 切换预设列宽
    // 也可以反向循环遍历预设。
    // Mod+R { switch-preset-column-width-back; }
    // Mod+Shift+R { switch-preset-window-height; } // 切换预设窗口高度
    // Mod+Ctrl+R { reset-window-height; }      // 重置窗口高度
    Mod+F { maximize-column; }               // 最大化列
    Mod+Shift+F { fullscreen-window; }       // 全屏窗口

    // 将聚焦列扩展到未被其他完全可见列占用的空间。
    // 使列"填充剩余空间"。
    Mod+Ctrl+F { expand-column-to-available-width; } // 扩展列填充可用宽度

    Mod+C { center-column; }                        // 居中列

    // 在屏幕上居中所有完全可见的列。
    Mod+Ctrl+C { center-visible-columns; }          // 居中所有可见列


    Mod+Minus { set-column-width "-10%"; }    // 减少列宽 10%
    Mod+Equal { set-column-width "+10%"; }    // 增加列宽 10%
    Mod+Shift+Minus { set-window-height "-10%"; } // 减少窗口高度 10%
    Mod+Shift+Equal { set-window-height "+10%"; } // 增加窗口高度 10%

    // 在浮动布局和平铺布局之间移动聚焦窗口。
    Mod+V       { toggle-window-floating; }       // 切换窗口浮动状态
    Mod+Shift+V { switch-focus-between-floating-and-tiling; } // 在浮动和平铺窗口间切换焦点

    // 切换选项卡式列显示模式。
    // 此列中的窗口将显示为垂直选项卡，
    // 而不是堆叠在一起。
    Mod+W { toggle-column-tabbed-display; }       // 切换列选项卡显示模式

    // 切换布局的动作。
    // 注意：如果取消注释这些，请确保上面的 xkb 选项中
    // 没有配置匹配的布局切换热键。
    // 在同一热键上同时配置两者会破坏切换，
    // 因为按下热键时会切换两次（一次由 xkb，一次由 niri）。
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    // Print { screenshot; }           // 截图整个屏幕
    Mod+Delete { screenshot-screen; } // 截图当前屏幕
    Alt+Mod+Delete { screenshot-window; }  // 截图当前窗口
    Alt+F12 { spawn-sh "FILE_NAME=\"$HOME/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S)_selection.png\" && slurp | grim -g - - | tee \"$FILE_NAME\" | wl-copy --type image/png"; } // 区域截图并复制到剪贴板

    // 诸如远程桌面客户端和软件 KVM 切换器等应用程序
    // 可能会请求 niri 停止处理此处定义的键盘快捷键，
    // 以便它们可以例如将按键原样转发到远程机器。
    // 最好绑定一个逃生舱来切换抑制器，
    // 这样有问题的应用程序就无法劫持你的会话。
    //
    // allow-inhibiting=false 属性也可以应用于其他绑定，
    // 这确保 niri 总是处理它们，即使在抑制器处于活动状态时也是如此。
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // 退出操作将显示确认对话框以避免意外退出。
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // 关闭显示器电源。要重新打开它们，
    // 执行任何输入操作，如移动鼠标或按任何其他键。
    Mod+Shift+P { power-off-monitors; }
}
